@model Producto
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="row g-3">
 <div class="col-md-4"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control"/><span asp-validation-for="Codigo" class="text-danger"></span></div>
 <div class="col-md-8"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Categoria" class="form-label"></label><input asp-for="Categoria" class="form-control"/><span asp-validation-for="Categoria" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="TipoVenta" class="form-label"></label><select asp-for="TipoVenta" asp-items="Html.GetEnumSelectList<TipoVenta>()" class="form-select"></select><span asp-validation-for="TipoVenta" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Precio" class="form-label">Precio (por unidad o por kg)</label><input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="Precio" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="Existencia" class="form-label">Existencia (unidades o kg)</label><input asp-for="Existencia" type="number" step="0.001" min="0" max="9999" class="form-control"/><span asp-validation-for="Existencia" class="text-danger"></span></div>
 <div class="col-12"><div class="form-check"><input asp-for="Activo" class="form-check-input"/><label asp-for="Activo" class="form-check-label"></label></div></div>
</div>
<div class="mt-4"><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
