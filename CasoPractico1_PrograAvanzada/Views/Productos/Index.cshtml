@using CasoPractico1_PrograAvanzada.Models
@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Listado de productos";
}

<h2>Listado de productos</h2>

<p>Consulta los productos registrados en la tienda.</p>

<form asp-action="Index" method="get">
    <label>Buscar producto:</label>
    <input type="text" name="filtro"
           value="@ViewBag.Filtro"
           placeholder="Nombre o categoría" />

    <label>Unidad de medida:</label>
    <select name="unidad"
            asp-items="Html.GetEnumSelectList<UnidadMedida>()">
        <option value="">Todas</option>
    </select>

    <button type="submit" class="btn btn-primary">
        Buscar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Limpiar
    </a>
</form>

<br />

<a asp-action="Create" class="btn btn-success">
    Nuevo producto
</a>

<br />
<br />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Existencia</th>
            <th>Unidad de medida</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Codigo</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>₡@producto.Precio.ToString("N2")</td>
                <td>@producto.Existencia</td>
                <td>@producto.UnidadMedida</td>
                <td>
                    @(producto.Activo ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@producto.Id"
                       class="btn btn-info btn-sm">
                        Detalle
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@producto.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@producto.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No se encontraron productos.</p>
}
